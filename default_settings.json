{
  "window": {
    "title": "Flybox Scanner",
    "resizable": false,
    "width": 640,
    "height": 480
  },
  "grid": {
    "rows": 8,
    "columns": 12
  },
  "video": {
    "source": 0,
    "frame_delay": 30
  },
  "recording": {
    "output_file": null,
    "interval": 60
  },
  "motion": {
    "history": 12000,
    "dist2_threshold": 165,
    "kernel_size": 12,
    "blur_size": 5,
    "diff_threshold": 15,
    "bg_reinit_threshold": 1,
    "bg_reinit_throttle": 5,
    "min_contour_area": 1,
    "max_contour_area_fraction": 0.05,
    "max_point_age": 100
  }
}
